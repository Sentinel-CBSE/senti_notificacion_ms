# Copia este archivo a `.env` para desarrollo local. En Azure NO se usa .env:
# las mismas variables se definen en el Container App (secretos para las sensibles).
# docker compose también lee este archivo (para el SQL Server local y para el servicio `api`).

# Por defecto es production (sin /docs ni /redoc). development los abre; /openapi.json siempre está disponible.
# En local usa development; en Azure no la definas o ponla en production.
ENV=development
LOG_LEVEL=INFO

# --- SQL Server / Azure SQL (mismo motor en local y en producción) ---
# Con `docker compose`, el servicio `api` sobreescribe DB_HOST=sqlserver (nombre del servicio en la
# red de Docker). Aquí va el valor para correr uvicorn en tu máquina contra el contenedor.
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
# REEMPLAZA este placeholder por tu propia contraseña local (no se sube: .env está en .gitignore).
# Debe cumplir la complejidad de SQL Server (8+ caracteres y 3 de 4: mayúscula, minúscula, número,
# símbolo), o el contenedor de SQL Server no arranca. Evita el carácter `$`: compose lo interpreta.
DB_PASSWORD=<tu-password-local>
DB_DATABASE=senti_notificacion
# El contenedor local usa certificado autofirmado: en local, TRUST_SERVER_CERTIFICATE=true.
# En Azure SQL: DB_ENCRYPT=true y DB_TRUST_SERVER_CERTIFICATE=false.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# --- Service Bus (worker) ---
# false = solo endpoint HTTP (no necesita Service Bus ni Firebase)
SERVICEBUS_ENABLED=true
SERVICEBUS_QUEUE_NAME=senti-notificaciones
# Emulador local (docker compose up -d); desde uvicorn en tu máquina el host es localhost.
# El servicio `api` de compose sobreescribe esto con sb://servicebus.
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
# Azure: Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=...;SharedAccessKey=...
SERVICEBUS_BATCH_SIZE=10
SERVICEBUS_MAX_WAIT_SECONDS=30

# --- Firebase: usa UNA de las dos (si están ambas, gana JSON) ---
# Local: nombre del archivo de la cuenta de servicio dentro de ./secrets/ (compose lo monta en /secrets)
FIREBASE_CREDENTIALS_FILE=firebase-service-account.json
# Ruta para correr uvicorn en tu máquina
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json
# Azure Container Apps: contenido completo del JSON en una sola línea (guardar como secreto)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
